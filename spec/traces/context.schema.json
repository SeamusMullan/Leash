{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leash.dev/spec/traces/context/v1.schema.json",
  "title": "Leash context trace entry",
  "description": "Which files and memory artifacts a context selection exposed, how many tokens they cost, the context hash, and whether a later effect referenced each artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "effect_id",
    "at",
    "artifacts",
    "tokens",
    "context_hash"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "effect_id": {
      "$ref": "#/definitions/CasHash"
    },
    "at": {
      "$ref": "#/definitions/Timestamp"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "tokens",
          "referenced_later"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "memory",
              "task_state",
              "harness",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "hash": {
            "$ref": "#/definitions/CasHash"
          },
          "referenced_later": {
            "type": "boolean"
          }
        }
      }
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Total tokens contributed by the selection."
    },
    "context_hash": {
      "$ref": "#/definitions/CasHash"
    },
    "dropped": {
      "type": "integer",
      "minimum": 0,
      "description": "Artifacts considered but not selected."
    }
  },
  "definitions": {
    "CasHash": {
      "type": "string",
      "pattern": "^b3:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
