(* Leash grammar, draft v0.1 (2026-09-12).
   Notation: ISO-EBNF-like. `:=` defines, `|` alternates, `?` optional, `*` zero-or-more,
   `+` one-or-more, `( )` groups, terminals in single quotes, token classes in CAPS.
   Newlines are not significant except that a newline terminates a statement when the
   next token cannot continue the expression (see docs/02-language-spec.md §2.6).
   Contextual keywords are ordinary identifiers everywhere except where named below. *)

(* ---------- Program and items ---------- *)

Program      := ModuleDecl? Item* ;
ModuleDecl   := 'module' Path ;
Path         := IDENT ( '.' IDENT )* ;

Item         := UseDecl | TypeDecl | EnumDecl | FnDecl | ToolDecl | AgentDecl
              | MemoryDecl | TaskDecl | FlowDecl | ConstDecl | TestDecl ;

UseDecl      := 'use' Path ( '.' '{' IDENT ( ',' IDENT )* ','? '}' )? ;
ConstDecl    := 'pub'? 'let' IDENT ( ':' Type )? '=' Expr ;          (* must be pure *)

TypeDecl     := 'pub'? 'type' IDENT Generics? '=' Type ;
EnumDecl     := 'pub'? 'enum' IDENT Generics? '{' Variant ( ',' Variant )* ','? '}' ;
Variant      := IDENT ( '(' Params ')' )? ;
Generics     := '<' IDENT ( ',' IDENT )* '>' ;

FnDecl       := DOC? 'pub'? 'fn' IDENT Generics? '(' Params? ')' ( '->' Type )? EffectClause? Block ;
ToolDecl     := DOC 'pub'? 'tool' IDENT '(' Params? ')' ( '->' Type )? EffectClause? Block ;
Params       := Param ( ',' Param )* ','? ;
Param        := IDENT ':' Type ( '=' Expr )? ;
EffectClause := '!' '{' ( Effect ( ',' Effect )* ','? )? '}' ;
Effect       := 'llm' | 'tool' | 'shell' | 'fs.read' | 'fs.write' | 'net' | 'spawn'
              | 'human' | 'clock' | 'rand' | 'env' ;

AgentDecl    := DOC? 'pub'? 'agent' IDENT '=' Expr ;                (* Expr must have type Agent *)
MemoryDecl   := DOC? 'pub'? 'memory' IDENT '=' Expr ;               (* Expr must have type Resource *)

(* ---------- Tasks and flows ---------- *)

TaskDecl     := DOC? 'pub'? 'task' IDENT '{' TaskSection* '}' ;
TaskSection  := 'input'  RecordType
              | 'output' Type
              | 'require' '{' ( Expr ( ',' Expr )* ','? )? '}'
              | 'ensure'  '{' ( Check ( ',' Check )* ','? )? '}'
              | 'budget'  ScopeVal
              | 'allow'   ScopeVal
              | 'deny'    ScopeVal ;
ScopeVal     := RecordLit | '(' Expr ')' | Path ( '(' Args? ')' )? ;
              (* task-section form: `allow caps.read_only` or `allow caps.sandbox_edit([...])` is fine because
                 the next token is a section keyword or `}`; in the block forms below a non-literal MUST be
                 parenthesised, otherwise `allow caps.x { ... }` would parse as a named record literal. *)
(* `input output require ensure deny` are contextual keywords inside a task body. *)

Check        := 'check' '(' STRING ')' 'by' Expr CheckOpt* ;
CheckOpt     := 'expect' Expr                (* predicate over the check result: stdout, exit_code, ... *)
              | 'within' Expr                (* Duration *)
              | 'on_timeout' Expr ;          (* .Fail (default) | .Record | .Skip *)

FlowDecl     := DOC? 'pub'? 'flow' IDENT '(' IDENT ( ':' Type )? ')' ( '->' Type )? EffectClause? Block ;

TestDecl     := 'test' STRING ( 'with' RecordLit )? Block ;     (* `test` is contextual: an item that starts with `test` STRING *)

(* ---------- Types ---------- *)

Type         := UnionFreeType ( '?' )? ;
UnionFreeType:= PrimType | NamedType | ListType | TupleType | RecordType | FnType | '(' Type ')' ;
PrimType     := 'Int' | 'Float' | 'Bool' | 'String' | 'Bytes' | 'Duration' | 'Money' | 'Unit' | 'Json' ;
NamedType    := Path ( '<' Type ( ',' Type )* '>' )? ;
ListType     := '[' Type ']' ;
TupleType    := '(' Type ',' Type ( ',' Type )* ','? ')' ;
RecordType   := '{' ( Field ( ',' Field )* ','? )? '}' ;
Field        := IDENT ':' Type ( 'where' Expr )? ;
FnType       := 'fn' '(' ( Type ( ',' Type )* )? ')' '->' Type EffectClause? ;

(* ---------- Statements and blocks ---------- *)

Block        := '{' Stmt* Expr? '}' ;
Stmt         := ( LetStmt | VarStmt | AssignStmt | StateStmt | CheckpointStmt | ExprStmt ) ';'? ;
LetStmt      := 'let' Pattern ( ':' Type )? '=' Expr ;
VarStmt      := 'var' IDENT ( ':' Type )? '=' Expr ;
AssignStmt   := LValue ( '=' | '+=' | '-=' ) Expr ;
LValue       := IDENT ( '.' IDENT | '[' Expr ']' )* ;
StateStmt    := 'state' '{' ( IDENT ':' Type '=' Expr ( ',' IDENT ':' Type '=' Expr )* ','? )? '}' ;
              (* contextual; only at the top of a flow body; declares the mutable record `state` *)
CheckpointStmt := 'checkpoint' STRING ;
ExprStmt     := Expr ;

(* ---------- Expressions (lowest to highest precedence) ---------- *)

Expr         := ControlExpr | OrExpr ;

ControlExpr  := IfExpr | MatchExpr | ForExpr | WhileExpr | LoopExpr | ReturnExpr
              | BreakExpr | ContinueExpr | FailExpr | AttemptExpr | RetryExpr
              | ParallelExpr | RaceExpr | AskExpr | RunExpr | SpawnExpr | AwaitExpr
              | VerifyExpr | CompleteExpr | BudgetExpr | AllowExpr | Lambda ;

IfExpr       := 'if' Expr Block ( 'else' ( IfExpr | Block ) )? ;
MatchExpr    := 'match' Expr '{' MatchArm ( ',' MatchArm )* ','? '}' ;
MatchArm     := Pattern ( 'if' Expr )? '=>' Expr ;
ForExpr      := 'for' Pattern 'in' Expr Block ;
WhileExpr    := 'while' Expr Block ;
LoopExpr     := 'loop' Block ;
ReturnExpr   := 'return' Expr? ;
BreakExpr    := 'break' Expr? ;
ContinueExpr := 'continue' ;

FailExpr     := 'fail' ( FailureKind ( '(' Expr ( ',' Expr )* ')' )? | Expr ) ;
FailureKind  := 'Context' | 'Tool' | 'Feedback' | 'Verify' | 'Recovery' | 'Entropy'
              | 'Model' | 'Budget' | 'Permission' | 'Replay' | 'Unknown' ;
AttemptExpr  := 'attempt' Block RecoverArm+ ;
RecoverArm   := 'recover' ( FailureKind | '_' ) ( 'as' IDENT )? Block ;
RetryExpr    := 'retry' '(' Expr ( ',' NamedArg )* ','? ')' Block ;        (* retry(n, on: Verify, backoff: .None) *)
ParallelExpr := 'parallel' ( '(' NamedArg ( ',' NamedArg )* ')' )? '{' Expr ( ',' Expr )* ','? '}' ;
RaceExpr     := 'race' '{' Expr ( ',' Expr )* ','? '}' ;

AskExpr      := 'ask' PostfixExpr '(' Args? ')' ;      (* ask agent(prompt, name: value, ...) *)
RunExpr      := 'run' PostfixExpr '(' Args? ')' ;      (* run agent(task: ..., context: ..., tools: ...) *)
SpawnExpr    := 'spawn' ( AskExpr | RunExpr | CallLike ) ;
CallLike     := PostfixExpr ;                          (* must be a call expression *)
AwaitExpr    := 'await' Expr ;
VerifyExpr   := 'verify' ( 'ensure' | '[' STRING ( ',' STRING )* ']' | Check ) ;
CompleteExpr := 'complete' Expr ;
BudgetExpr   := 'budget' ( RecordLit | '(' Expr ')' ) Block ;
AllowExpr    := 'allow'  ( RecordLit | '(' Expr ')' ) Block ;

Lambda       := ( IDENT | '(' ( IDENT ( ',' IDENT )* )? ')' ) '=>' ( Block | Expr ) ;

OrExpr       := AndExpr ( 'or' AndExpr )* ;
AndExpr      := NotExpr ( 'and' NotExpr )* ;
NotExpr      := 'not' NotExpr | CmpExpr ;
CmpExpr      := AddExpr ( ( '==' | '!=' | '<' | '<=' | '>' | '>=' ) AddExpr )? ;
AddExpr      := MulExpr ( ( '+' | '-' ) MulExpr )* ;
MulExpr      := UnaryExpr ( ( '*' | '/' | '%' ) UnaryExpr )* ;
UnaryExpr    := '-' UnaryExpr | PostfixExpr ;
PostfixExpr  := PrimaryExpr Postfix* ;
Postfix      := '.' IDENT                              (* field access or UFCS method *)
              | '.' IDENT '(' Args? ')' TrailingLambda?
              | '(' Args? ')' TrailingLambda?
              | '[' Expr ']'
              | '?'  ;                                 (* optional chaining: e?.f, e?[i] *)
TrailingLambda := '{' ( IDENT | '(' IDENT ( ',' IDENT )* ')' ) '=>' Stmt* Expr? '}' ;
Args         := Arg ( ',' Arg )* ','? ;
Arg          := NamedArg | Expr ;
NamedArg     := IDENT ':' Expr ;

PrimaryExpr  := Literal | Path | RecordLit | NamedRecordLit | ListLit | TupleLit
              | VariantLit | '(' Expr ')' | Block ;
Literal      := INT | FLOAT | STRING | RAWSTRING | DURATION | 'true' | 'false' | 'null' ;
RecordLit    := '{' ( FieldInit ( ',' FieldInit )* ','? )? '}' ;
NamedRecordLit := Path RecordLit ;                     (* Triage { ... } ; Agent { ... } *)
FieldInit    := IDENT ( ':' Expr )? ;                  (* `{ id }` is shorthand for `{ id: id }` *)
ListLit      := '[' ( Expr ( ',' Expr )* ','? )? ']' ;
TupleLit     := '(' Expr ',' ( Expr ( ',' Expr )* )? ','? ')' ;
VariantLit   := '.' IDENT ( '(' Args? ')' )? ;         (* .High, .Merged(pr: 3) — needs an expected enum type *)

(* ---------- Patterns ---------- *)

Pattern      := '_' | IDENT | Literal
              | '(' Pattern ( ',' Pattern )* ','? ')'
              | '[' ( Pattern ( ',' Pattern )* )? ( '..' IDENT? )? ']'
              | '{' IDENT ( ':' Pattern )? ( ',' IDENT ( ':' Pattern )? )* ','? '}'
              | '.' IDENT ( '(' Pattern ( ',' Pattern )* ')' )?
              | FailureKind ( '(' Pattern ( ',' Pattern )* ')' )? ;

(* ---------- Lexical ---------- *)

IDENT        := /[A-Za-z_][A-Za-z0-9_]*/ ;             (* excluding hard keywords *)
INT          := /[0-9][0-9_]*/ ;
FLOAT        := /[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9]+)?/ ;
DURATION     := /[0-9][0-9_]*(ms|s|m|h)/ ;
STRING       := '"' ( CHAR | ESCAPE | INTERP )* '"'
              | '"""' NEWLINE ( CHAR | ESCAPE | INTERP | NEWLINE )* '"""' ;   (* common indent stripped *)
INTERP       := '{' Expr '}' ;                         (* `{{` and `}}` are literal braces *)
ESCAPE       := '\\' ( 'n' | 't' | 'r' | '0' | '\\' | '"' | '{' | '}' | 'u{' HEX+ '}' ) ;
RAWSTRING    := 'r"' CHAR* '"' | 'r"""' ( CHAR | NEWLINE )* '"""' ;   (* no escapes, no interpolation *)
DOC          := ( '///' CHAR* NEWLINE )+ ;
COMMENT      := '//' CHAR* NEWLINE | '/*' ( CHAR | NEWLINE )* '*/' ;   (* block comments nest *)

(* Hard keywords (reserved everywhere):
   module use pub let var fn type enum tool agent memory task flow
   ask run spawn await parallel race retry attempt recover fail checkpoint verify complete
   if else match for in while loop break continue return true false null and or not as where
   budget allow
   Contextual keywords (only special in the positions shown above):
   test (item-level, followed by STRING) input output require ensure deny check by expect within on_timeout
   state on backoff concurrency limit with
   Effect names and failure kinds are contextual identifiers. `gate`, `select`, `shell`, `test`
   (inside `by`) are ordinary std functions. *)

(* ---------- Parser ambiguity notes (WP-03) ---------- *)

(* The v0 parser is recursive descent with a Pratt loop and bounded lookahead.
   These notes record every place where the grammar above admits more than one
   parse and how the parser chooses. They are normative for v0 and must be
   revisited when WP-07 extends the grammar. *)

(* 1. Named record literals. `Path RecordLit` is a named record only when the
   path is exactly one segment, that segment starts with an uppercase letter,
   and the `{` is on the same line (no Newline token between them). Thus
   `Agent { ... }` and `Triage { ... }` are named records; `foo { ... }` is a
   path followed by a record literal, and `a.b { ... }` is not a named record.
   The capitalisation rule is what keeps `if cond { ... }` unambiguous: the
   `{` always starts the then-block, never a record-literal condition. A
   record literal used as an `if` condition must be parenthesised:
   `if ({ flag: true }).flag { ... }`. *)

(* 2. Trailing lambdas. After a call's closing `)`, a `{` starts a trailing
   lambda only when lookahead (skipping newlines) is `IDENT '=>'` or
   `'(' IDENT (',' IDENT)* ')' '=>'`. Anything else leaves the `{` to the
   enclosing construct. There is no empty trailing lambda: `f() {}` is not
   `f() { x => ... }`, and `f() { x }` is not a lambda. A trailing lambda is
   attached to a call or method call, not to a bare field access: `xs.map { x
   => ... }` is not accepted; write `xs.map() { x => ... }` or
   `map(xs) { x => ... }`. *)

(* 3. Lambda bodies vs record literals. After `IDENT '=>'` or `( params ) '=>'`
   a `{` is always a block body, never a record literal. To return a record
   from a lambda write `x => ({ a: x })`. Inside a trailing lambda the body is
   parsed as statements up to the matching `}`; a bare expression body is the
   final expression statement. *)

(* 4. Parenthesised expressions vs lambda parameters. `(` starts a lambda
   parameter list only when the matching `)` is followed by `=>`. Otherwise it
   is a parenthesised expression. `(a, b)` outside a lambda has no v0 meaning
   (tuple literals are WP-07) and produces E0100. *)

(* 5. Newline termination (docs/02 §2.6). The lexer emits Newline; the parser
   skips newlines before a binary operator, before a postfix `.`, and before
   `else`, so those continue the expression. A newline before `(` does NOT
   continue a call: `f\n(1)` is two statements. A newline before `[` does not
   continue indexing. Newlines inside `(...)`, `[...]`, `{...}` are skipped by
   the corresponding list/record/argument parser, so multi-line literals are
   allowed. A blank line is never significant to the grammar. *)

(* 6. `use` groups. `use Path.{A, B}` is recognised only when `.` is
   immediately followed by `{` while parsing the import path. The group may
   span lines inside the braces, but the `.` itself must be on the same line as
   the final path segment. `use a.b { A }` is a path followed by a record
   literal and is not an import group. *)

(* 7. `ask` targets. `ask` parses a postfix chain without calls as its target,
   then requires the argument list: `ask agent(args)` and
   `ask registry.agent(args)` are both valid. A call inside the target
   (`ask make_agent()(...)`) is not part of the v0 subset. *)

(* 8. Variant literals. `.Name` is a variant literal; `.Name(...)` is a variant
   payload and reports E0100 (WP-07). A leading `.` followed by an identifier
   after an expression is field access instead: the parser only treats `.` as
   the start of a primary expression when it appears in primary position. *)

(* 9. Blocks and record literals in expression position. A `{` in primary
   position is always a record literal, never a bare block. Blocks appear only
   as `if`/`else` arms, function/flow bodies and lambda bodies. To group
   statements use a lambda or an `if`. *)

(* 10. Task budget. `budget` accepts a record literal (`budget { ... }`) or a
   parenthesised expression (`budget (cost_limit)`). A bare expression is not
   accepted. `input` must be a record type; `output` accepts any type. *)

(* 11. Doc comments. A run of `///` lines attaches to the next token, and thus
   to the item or statement that token begins. A doc comment at end of file
   attaches to the program's trailing trivia. Blank lines do not detach a doc
   comment. *)
