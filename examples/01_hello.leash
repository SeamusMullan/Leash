// examples/01_hello.leash
// Smallest useful program: one typed model call, deterministic control flow.
module examples.hello

use std.drivers

agent namer = Agent {
  driver: drivers.anthropic(model: "claude-opus-5", effort: .Medium),
  system: "You name things. Answer with the schema only.",
}

type Suggestion = {
  name: String where len(name) <= 30,
  rationale: String,
}

task main {
  input  { topic: String }
  output [Suggestion]
  budget { cost: usd(0.50), llm_calls: 5 }
}

flow main(input) -> [Suggestion] {
  // The expected type [Suggestion] drives the JSON schema sent to the driver.
  let ideas: [Suggestion] = ask namer("Suggest three project names for: {input.topic}")

  // Deterministic post-processing. No model involved.
  let short = ideas.filter(s => len(s.name) < 12)
  if len(short) == 0 { fail Model("no short names produced") }
  complete short
}
