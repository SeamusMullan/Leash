#
# Turn the normative spec/ files and std/prices.toml into one generated .cpp of
# raw string literals. Invoked at build time by src/spec/CMakeLists.txt.
#
# Inputs (all -D):
#   SPEC_ROOT  repository root
#   OUTPUT     path of the generated .cpp
#   FILES      semicolon-separated paths relative to SPEC_ROOT

if(NOT DEFINED SPEC_ROOT OR NOT DEFINED OUTPUT OR NOT DEFINED FILES)
    message(FATAL_ERROR "embed_spec.cmake requires SPEC_ROOT, OUTPUT and FILES")
endif()

set(content "// SPDX-License-Identifier: Apache-2.0\n")
string(APPEND content "// Copyright 2026 The Leash Authors\n")
string(APPEND content "// Generated by src/spec/embed_spec.cmake; do not edit.\n\n")
string(APPEND content "#include <array>\n#include <optional>\n#include <string_view>\n\n")
string(APPEND content "#include \"embedded.hpp\"\n\n")
string(APPEND content "namespace leash::spec::detail {\nnamespace {\n\n")
string(APPEND content "struct Entry {\n    std::string_view name;\n    std::string_view text;\n};\n\n")
string(APPEND content "constexpr auto kEntries = std::to_array<Entry>({\n")

foreach(relative IN LISTS FILES)
    set(path "${SPEC_ROOT}/${relative}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "embed_spec.cmake: missing ${path}")
    endif()
    file(READ "${path}" text)
    string(FIND "${text}" ")LEASH\"" delimiter_position)
    if(NOT delimiter_position EQUAL -1)
        message(FATAL_ERROR "embed_spec.cmake: ${relative} contains the raw-string delimiter")
    endif()
    string(APPEND content "    {.name = \"${relative}\", .text = R\"LEASH(${text})LEASH\",},\n")
endforeach()

string(APPEND content "});\n\n")
string(APPEND content "} // namespace\n\n")
string(APPEND content "std::optional<std::string_view> embedded_file(std::string_view path) {\n")
string(APPEND content "    for (const auto& entry : kEntries) {\n")
string(APPEND content "        if (entry.name == path) {\n")
string(APPEND content "            return entry.text;\n")
string(APPEND content "        }\n")
string(APPEND content "    }\n")
string(APPEND content "    return std::nullopt;\n")
string(APPEND content "}\n\n")
string(APPEND content "} // namespace leash::spec::detail\n")

file(WRITE "${OUTPUT}" "${content}")
